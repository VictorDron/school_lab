{
  "name": "backend",
  "version": "1.0.0",
  "description": "School Lab Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:kanban": "tsx prisma/seeds/re-enrollment-kanban.seed.ts",
    "seed:re-enrollment-operational": "tsx prisma/seeds/re-enrollment-operational.seed.ts",
    "seed:re-enrollment-edge-cases": "tsx prisma/seeds/re-enrollment-edge-cases.seed.ts",
    "seed:rematricula": "tsx scripts/seed-rematricula-e2e.ts",
    "migrate:crm-access": "tsx scripts/migrate-crm-access.ts",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "worker": "tsx src/workers/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@supabase/supabase-js": "^2.39.7",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "fuse.js": "^7.1.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "langchain": "^0.1.25",
    "magic-bytes.js": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.6",
    "openai": "^4.28.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.10.2",
    "qrcode": "^1.5.3",
    "resend": "^3.2.0",
    "socket.io": "^4.7.4",
    "tsx": "^4.21.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "@types/passport": "^1.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "supertest": "^7.2.2",
    "typescript": "^5.4.2",
    "vitest": "^4.0.18"
  }
}
